{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .ts src",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "backfill:prices": "ts-node src/scripts/backfill_subject_prices.ts",
    "test": "npm run build && firebase emulators:exec --project demo-tarek-platform --only firestore,functions,auth \"node test/run_all.js\"",
    "test:pure": "npm run build && node test/rolling_window_policy.test.js && node test/final_decisions_addendum.test.js && node test/guest_migration.test.js"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^7.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0"
  },
  "private": true
}