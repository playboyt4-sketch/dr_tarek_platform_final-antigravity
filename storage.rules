rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ===== Helper functions =====

    function isSignedIn() {
      return request.auth != null;
    }

    function isDoctor() {
      return isSignedIn() && request.auth.token.role == 'doctor';
    }

    function hasAdminStoragePermission(permissionKey) {
      // NOTE: no firestore.exists() here on purpose. The Storage rules
      // emulator used by security-tests (@firebase/rules-unit-testing)
      // does not resolve cross-service firestore.exists() with
      // $(request.auth.uid) interpolation, which turns the whole
      // conjunction into deny (admin-with-content sheets.zip upload
      // fails). firestore.get() alone is sufficient: for a missing doc
      // .data is null, so the == true comparisons below are already false.
      return isSignedIn()
        && request.auth.token.role == 'admin'
        && firestore.get(/databases/(default)/documents/admin_permissions/$(request.auth.uid)).data.is_active == true
        && firestore.get(/databases/(default)/documents/admin_permissions/$(request.auth.uid)).data.permissions[permissionKey] == true;
    }

    function canManageContent() {
      return isDoctor() || hasAdminStoragePermission('admin_content');
    }

    function isImageWithinLimit(maxBytes) {
      return request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    // ===== Profile photos (student uploads own photo) =====

    match /profile_photos/{userId}/{fileName} {
      allow read: if isSignedIn()
        && (request.auth.uid == userId
          || request.auth.token.role == 'doctor'
          || request.auth.token.role == 'admin');

      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && isImageWithinLimit(5 * 1024 * 1024);

      allow delete: if isSignedIn()
        && request.auth.uid == userId;
    }

    // ===== Lecture resources (PDFs / attachments / thumbnails) =====
    // Client reads are DENIED: short-lived signed URLs are minted
    // server-side (generateProtectedPdfUrl / generatePdfDownloadUrl).
    // Upload / replace / delete are staff-only, max 50MB. Video bytes are
    // NEVER stored here — video delivery is Bunny CDN only (video_id
    // strings, never uploads), so explicit video/* content types are denied
    // even for staff. A null/inferred content type still passes: only an
    // explicit video/* declaration is rejected.
    match /lecture_resources/{lectureId}/{resourceId}/{fileName} {
      allow read: if false;
      allow create, update: if canManageContent()
        && request.resource.size <= 50 * 1024 * 1024
        && (request.resource.contentType == null
          || !request.resource.contentType.matches('video/.*'));
      allow delete: if canManageContent();
    }

    // ===== Subject posters (uploaded at subject creation, replaceable) =====

    match /subject_posters/{subjectId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if canManageContent()
        && isImageWithinLimit(5 * 1024 * 1024);
      allow delete: if canManageContent();
    }

    // ===== Everything else: fully denied =====
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
