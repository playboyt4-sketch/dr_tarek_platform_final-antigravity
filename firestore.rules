rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return (signedIn() && 'role' in request.auth.token) ? request.auth.token.role : null;
    }

    function isDoctor() {
      return signedIn() && role() == 'doctor';
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isStudent() {
      return signedIn()
        && role() == 'student'
        && request.auth.token.approved == true;
    }

    function isCenterStudent() {
      return isStudent() && request.auth.token.student_type == 'center_student';
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isStaff() {
      return isDoctor() || isAdmin();
    }

    // Single-get() check on an already-fetched admin_permissions doc.
    // Kept separate so activeAdminPermission() performs exactly one get()
    // after the exists() guard (short-circuit preserved).
    function adminPermSatisfied(permDoc, permissionKey) {
      return permDoc.data.is_active == true
        && permDoc.data.permissions[permissionKey] == true;
    }

    function activeAdminPermission(permissionKey) {
      return isAdmin()
        && exists(/databases/$(database)/documents/admin_permissions/$(request.auth.uid))
        && adminPermSatisfied(get(/databases/$(database)/documents/admin_permissions/$(request.auth.uid)), permissionKey);
    }

    function canManageStudents() {
      return isDoctor() || activeAdminPermission('admin_students');
    }

    function canManageContent() {
      return isDoctor() || activeAdminPermission('admin_content');
    }

    function canCommunicate() {
      return isDoctor() || activeAdminPermission('admin_chat');
    }

    function canViewAnalytics() {
      return isDoctor() || activeAdminPermission('admin_analytics');
    }

    function canManageDevices() {
      return isDoctor() || activeAdminPermission('admin_devices');
    }

    function canViewPayments() {
      return isDoctor() || activeAdminPermission('admin_payments_view');
    }

    function canManagePayments() {
      return isDoctor() || activeAdminPermission('admin_payments');
    }

    function canResetPassword() {
      // Sole delegated key is `password_reset` (Project Owner decision:
      // the dotted `password.reset` key is retired and no longer honored).
      return isDoctor()
        || activeAdminPermission('password_reset');
    }

    function canManageAcademicTerms() {
      return isDoctor() || activeAdminPermission('admin_academic_terms');
    }

    function canManageSettings() {
      return isDoctor() || activeAdminPermission('admin_settings');
    }

    function hasNoPasswordHash(data) {
      return !data.keys().hasAny(['password_hash']);
    }

    function isApprovedContent(data) {
      return isStudent()
        && data.get('is_deleted', false) != true
        && data.get('status', 'none') == 'published';
    }

    function hasSubjectAccess(userId, subjectId) {
      return exists(/databases/$(database)/documents/subject_access_assignments/$(userId + '_' + subjectId))
        && get(/databases/$(database)/documents/subject_access_assignments/$(userId + '_' + subjectId)).data.is_deleted == false;
    }

    // Subscription-expiry drift fix: subscriptions.end_date is the official
    // expiry source. Rules cannot query the subscriptions collection
    // (random document IDs), so expiry is enforced from its server-maintained
    // mirror on the assignment row — written transactionally from end_date on
    // grant/activate/plan-change and from the term binding on term-expiry,
    // never client-writable (assignments are write:false). end_date == null
    // means a lifetime subscription and always passes; a missing mirror
    // fails closed (deny), exactly like before. Ownership, subject scoping,
    // and the Feature Matrix (entitlements) checks are unchanged.
    function hasEntitlement(userId, subjectId, entitlementName) {
      let assignment = get(/databases/$(database)/documents/subject_access_assignments/$(userId + '_' + subjectId));
      let expiry = assignment.data.get('subscription_expires_at', request.time);
      return exists(/databases/$(database)/documents/subject_access_assignments/$(userId + '_' + subjectId))
        && assignment.data.is_deleted == false
        && (expiry == null || expiry > request.time)
        && entitlementName in assignment.data.entitlements;
    }

    // V1 Individual Per-Lecture Student Access (project-owner approved).
    // Explicit per-student deny override: a grant document
    // lecture_access_grants/{lectureId_studentId} with allowed == false
    // denies the lecture even when plan/subject checks would pass.
    // Missing grant (or allowed == true) defers to the normal model.
    function lectureAccessGrantId(lectureId, userId) {
      return lectureId + '_' + userId;
    }

    // Single-get() check on an already-fetched lecture_access_grants doc.
    function lectureGrantDenied(grantDoc) {
      return grantDoc.data.allowed == false
        && grantDoc.data.get('is_deleted', false) != true;
    }

    function isLectureDenied(userId, lectureId) {
      return lectureId is string && lectureId.size() > 0
        && exists(/databases/$(database)/documents/lecture_access_grants/$(lectureAccessGrantId(lectureId, userId)))
        && lectureGrantDenied(get(/databases/$(database)/documents/lecture_access_grants/$(lectureAccessGrantId(lectureId, userId))));
    }

    function canManageLectureAccess() {
      return isDoctor() || canManageStudents() || canManageContent();
    }

    // User profiles are readable only after password_hash has been migrated
    // out of users/{userId}. All sensitive transitions use Admin SDK Functions.
    match /users/{userId} {
      allow get, list: if signedIn()
        && hasNoPasswordHash(resource.data)
        && (isSelf(userId) || canManageStudents() || isDoctor());

      allow create, delete: if false;

      // Students may edit only non-sensitive profile fields. Role, approval,
      // account status, device binding, grade, and secrets are immutable here.
      allow update: if isSelf(userId)
        && hasNoPasswordHash(resource.data)
        && hasNoPasswordHash(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'full_name',
          'display_handle',
          'profile_photo',
          'updated_at',
          'updated_by'
        ]);
    }

    // Password hashes and other authentication secrets are server-only.
    match /user_secrets/{userId} {
      allow read, write: if false;
    }

    match /admin_permissions/{adminId} {
      allow get: if isDoctor()
        || (isAdmin() && isSelf(adminId));
      allow list: if isDoctor();
      allow create, update, delete: if isDoctor();
    }

    match /admin_audit_log/{auditId} {
      allow get, list: if isDoctor()
        || (isAdmin() && resource.data.actor_id == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /users/{userId}/audit_events/{eventId} {
      allow get, list: if isSelf(userId) || isDoctor() || canViewAnalytics();
      allow write: if false;
    }

    // Device Registry (ADR-004): recognition/audit metadata only. No rule
    // compares a client-provided device identifier as proof of hardware;
    // dynamic device-tier decisions live server-side in Cloud Functions.
    match /devices/{deviceId} {
      allow get, list: if (isStudent() && resource.data.user_id == request.auth.uid)
        || canManageDevices();
      allow create, update, delete: if false;
    }

    // Subject-Device Authorization (ADR-004): server-written only.
    // Students read their own rows; staff manage visibility via existing
    // device-management delegation. No client tier marker is introduced.
    match /subject_device_authorizations/{authorizationId} {
      allow get, list: if (isStudent() && resource.data.student_id == request.auth.uid)
        || canManageDevices();
      allow create, update, delete: if false;
    }

    // Max Playback Sessions (ADR-004 follow-up): server-written only.
    // Session authority lives in Cloud Functions; clients hold opaque
    // tokens, never session state. No client session writes are allowed.
    match /playback_sessions/{sessionId} {
      allow get, list: if (isStudent() && resource.data.student_id == request.auth.uid)
        || canManageDevices();
      allow create, update, delete: if false;
    }

    // Student self-requests may only open a pending request in the
    // server-known request shape. Staff resolution (approve/reject with
    // decided_by/resolved_at) stays staff-only via update; client-chosen
    // status/decision/timestamp fields are never creatable.
    match /device_change_requests/{requestId} {
      allow get, list: if (isStudent() && resource.data.student_id == request.auth.uid)
        || canManageDevices();
      allow create: if isStudent()
        && request.resource.data.student_id is string
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.diff({}).affectedKeys().hasOnly(['student_id', 'status', 'requested_at', 'old_device_id', 'new_device_id']);
      allow update, delete: if canManageDevices();
    }

    match /device_security_alerts/{alertId} {
      allow get, list: if canManageDevices() || canViewAnalytics();
      allow write: if false;
    }

    match /auth_security_events/{eventId} {
      allow get, list: if canManageDevices() || canViewAnalytics();
      allow write: if false;
    }

    match /security_events/{eventId} {
      allow get, list: if canManageDevices() || canViewAnalytics();
      allow write: if false;
    }

    match /analytics_events/{eventId} {
      allow get, list: if canViewAnalytics()
        || (signedIn() && resource.data.user_id == request.auth.uid);
      allow write: if false;
    }

    match /subjects/{subjectId} {
      allow get, list: if (isStudent() && resource.data.is_deleted != true && resource.data.is_visible == true)
        || canManageContent()
        || isDoctor();
      allow create: if canManageContent()
        && request.resource.data.get('is_deleted', false) == false
        && request.resource.data.get('title', '') is string;
      allow update: if canManageContent()
        && request.resource.data.get('is_deleted', false) == false;
      allow delete: if false;
    }

    match /subject_sections/{sectionId} {
      allow get, list: if (isStudent() && resource.data.is_deleted != true && resource.data.is_visible == true)
        || canManageContent()
        || isDoctor();
      allow create: if canManageContent();
      allow update: if canManageContent() 
        && (!('is_deleted' in request.resource.data) || request.resource.data.is_deleted == false || resource.data.is_system_section != true);
      allow delete: if false;
    }

    match /lectures/{lectureId} {
      allow get, list: if isApprovedContent(resource.data)
        || canManageContent()
        || isDoctor();
      allow create: if canManageContent();
      allow update: if canManageContent();
      allow delete: if false;
    }

    match /lecture_resources/{resourceId} {
      allow get, list: if (resource == null ? false : (isApprovedContent(resource.data) && hasSubjectAccess(request.auth.uid, resource.data.get('subject_id', 'missing-subject')) && !isLectureDenied(request.auth.uid, resource.data.get('lecture_id', ''))))
        || canManageContent()
        || isDoctor();
      allow create: if canManageContent();
      allow update: if canManageContent();
      allow delete: if false;
    }

    // V1 Individual Per-Lecture Student Access grants.
    // Staff manage via the centralized permission model (doctor,
    // student-management, or content-management delegation) — no new
    // permission key. Students have NO access here: enforcement is
    // server-side (Cloud Functions + the lecture_resources gate above),
    // so the collection is never client-readable for students.
    // Soft-delete audit fields are part of the approved schema for
    // architectural consistency; clients always write the active state
    // (revocation is allowed=false, never a delete — delete stays denied).
    match /lecture_access_grants/{grantId} {
      allow get, list: if canManageLectureAccess();
      allow create: if canManageLectureAccess()
        && request.resource.data.lecture_id is string
        && request.resource.data.student_id is string
        && request.resource.data.allowed is bool
        && request.resource.data.is_deleted == false
        && (request.resource.data.lecture_id + '_' + request.resource.data.student_id) == grantId;
      allow update: if canManageLectureAccess()
        && request.resource.data.lecture_id is string
        && request.resource.data.student_id is string
        && request.resource.data.allowed is bool
        && request.resource.data.is_deleted == false
        && (request.resource.data.lecture_id + '_' + request.resource.data.student_id) == grantId
        && request.resource.data.lecture_id == resource.data.lecture_id
        && request.resource.data.student_id == resource.data.student_id;
      allow delete: if false;
    }

    // Progress writes are limited to the playback-repository shape
    // (student_id, lecture_id plus position/completion/PDF keys). Arbitrary
    // client-controlled fields are rejected; ownership is unchanged.
    match /learning_progress/{progressId} {
      // Owner-prefix get: progress docs are keyed `{uid}_{lectureId}`, so the
      // owner may read a not-yet-created doc (resource == null) without a
      // permission-denied. Cross-owner reads still fail (prefix mismatch) and
      // listing is ownership-filtered below.
      allow get: if isStudent() && progressId.matches(request.auth.uid + '_.*');
      allow list: if (isStudent() && resource.data.student_id == request.auth.uid)
        || canViewAnalytics();
      allow create: if isStudent()
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.diff({}).affectedKeys().hasOnly(['student_id', 'lecture_id', 'subject_id', 'section_id', 'lecture_title', 'thumbnail_url', 'position_seconds', 'video_position_seconds', 'duration_seconds', 'progress_percent', 'completed', 'is_completed', 'completed_at', 'pdf_last_page', 'pdf_total_pages', 'updated_at']);
      allow update: if isStudent()
        && resource.data.student_id == request.auth.uid
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['student_id', 'lecture_id', 'subject_id', 'section_id', 'lecture_title', 'thumbnail_url', 'position_seconds', 'video_position_seconds', 'duration_seconds', 'progress_percent', 'completed', 'is_completed', 'completed_at', 'pdf_last_page', 'pdf_total_pages', 'updated_at']);
      allow delete: if false;
    }

    match /lecture_progress/{progressId} {
      // Owner-prefix get: same rationale as learning_progress above — first
      // playback has no doc yet and must not fail with permission-denied.
      allow get: if isStudent() && progressId.matches(request.auth.uid + '_.*');
      allow list: if (isStudent() && resource.data.student_id == request.auth.uid)
        || canViewAnalytics();
      allow create: if isStudent()
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.lecture_id is string
        && request.resource.data.diff({}).affectedKeys().hasOnly(['student_id', 'lecture_id', 'subject_id', 'section_id', 'lecture_title', 'thumbnail_url', 'position_seconds', 'video_position_seconds', 'duration_seconds', 'progress_percent', 'completed', 'is_completed', 'completed_at', 'pdf_last_page', 'pdf_total_pages', 'updated_at']);
      allow update: if isStudent()
        && resource.data.student_id == request.auth.uid
        && request.resource.data.student_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['student_id', 'lecture_id', 'subject_id', 'section_id', 'lecture_title', 'thumbnail_url', 'position_seconds', 'video_position_seconds', 'duration_seconds', 'progress_percent', 'completed', 'is_completed', 'completed_at', 'pdf_last_page', 'pdf_total_pages', 'updated_at']);
      allow delete: if false;
    }

    match /subject_progress_summary/{summaryId} {
      allow get, list: if (isStudent() && resource.data.student_id == request.auth.uid)
        || canViewAnalytics();
      allow write: if false;
    }

    match /subscriptions/{subscriptionId} {
      allow get, list: if (isStudent() && resource.data.student_id == request.auth.uid)
        || canManageStudents()
        || isDoctor();
      allow write: if false;
    }

    match /subject_access_assignments/{assignmentId} {
      allow get, list: if (isStudent() && resource.data.student_id == request.auth.uid && resource.data.is_deleted == false)
        || canManageStudents()
        || isDoctor();
      allow write: if false;
    }

    match /plans/{planId} {
      allow get, list: if (isStudent() && resource.data.is_active == true)
        || canManageStudents()
        || isDoctor();
      allow write: if false;
    }

    match /custom_groups/{groupId} {
      allow get, list: if isStaff();
      allow write: if false;
    }

    match /plan_features/{featureId} {
      allow get, list: if (isStudent() && resource.data.enabled == true)
        || canManageContent()
        || isDoctor();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow get, list: if (isStudent() && resource.data.user_id == request.auth.uid)
        || canCommunicate()
        || isDoctor();
      allow create: if canCommunicate();
      allow delete: if false;
      allow update: if isStudent()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read', 'read_at'])
        && request.resource.data.is_read == true;

      match /deliveries/{deliveryId} {
        allow get, list: if (isStudent() && resource.data.user_id == request.auth.uid)
          || canCommunicate()
          || isDoctor();
        allow write: if false;
      }
    }

    // Chat and Student Questions systems are removed from the current phase.
    match /questions/{questionId} {
      allow read, write: if false;
    }

    match /chat_threads/{threadId} {
      allow read, write: if false;

      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    match /notes/{noteId} {
      allow get, list: if isStudent() && resource.data.student_id == request.auth.uid && hasEntitlement(request.auth.uid, resource.data.subject_id, 'notes.create');
      allow create: if isStudent()
        && request.resource.data.student_id == request.auth.uid
        && hasEntitlement(request.auth.uid, request.resource.data.subject_id, 'notes.create');
      allow update: if isStudent()
        && resource.data.student_id == request.auth.uid
        && request.resource.data.student_id == request.auth.uid
        && hasEntitlement(request.auth.uid, request.resource.data.subject_id, 'notes.create');
      allow delete: if isStudent() && resource.data.student_id == request.auth.uid;
    }

    match /bookmarks/{bookmarkId} {
      allow get, list: if isStudent() && resource.data.student_id == request.auth.uid && hasEntitlement(request.auth.uid, resource.data.subject_id, 'bookmarks.create');
      allow create: if isStudent()
        && request.resource.data.student_id == request.auth.uid
        && hasEntitlement(request.auth.uid, request.resource.data.subject_id, 'bookmarks.create');
      allow update: if isStudent()
        && resource.data.student_id == request.auth.uid
        && request.resource.data.student_id == request.auth.uid
        && hasEntitlement(request.auth.uid, request.resource.data.subject_id, 'bookmarks.create');
      allow delete: if isStudent() && resource.data.student_id == request.auth.uid;
    }

    match /timeline_quizzes/{quizId} {
      allow get, list: if isApprovedContent(resource.data)
        || canManageContent()
        || isDoctor();
      allow write: if false;
    }

    match /quiz_attempts/{attemptId} {
      allow get, list: if (isStudent() && resource.data.student_id == request.auth.uid)
        || canViewAnalytics();
      allow create: if isStudent() 
        && request.resource.data.student_id == request.auth.uid
        && !('score' in request.resource.data)
        && !('percentage' in request.resource.data)
        && !('passed' in request.resource.data);
      // Submission and grading happen only through the
      // submitAssessmentAttempt callable (Admin SDK) — clients can
      // start attempts (create) but NEVER update them, not even for
      // answers-only payloads. See BR-09 (immutable submissions).
      allow update: if false;
      allow delete: if false;
    }

    match /exams/{examId} {
      allow get, list: if isApprovedContent(resource.data)
        || canManageContent()
        || isDoctor();
      allow write: if false;
    }

    match /exam_attempts/{attemptId} {
      allow get, list: if (isStudent() && resource.data.student_id == request.auth.uid)
        || canViewAnalytics();
      allow create: if isStudent() 
        && request.resource.data.student_id == request.auth.uid
        && !('score' in request.resource.data)
        && !('percentage' in request.resource.data)
        && !('passed' in request.resource.data);
      // Submission and grading happen only through the
      // submitExamAttempt callable (Admin SDK) — clients can start
      // attempts (create) but NEVER update them, not even for
      // answers-only payloads. See BR-09 (immutable submissions).
      allow update: if false;
      allow delete: if false;
    }

    // Student-level payment ledger (payment_logs): staff read-only
    // visibility; all writes go exclusively through the Doctor-only
    // payment callables (onPaymentLogged, correctPaymentLog,
    // setStudentFinancialAccount via Admin SDK), never direct clients.
    match /payment_logs/{paymentId} {
      allow get, list: if canViewPayments() || canManagePayments() || isDoctor();
      allow write: if false;
    }

    // Student financial accounts (student-level finance): staff read-only
    // visibility for the Dashboard ledger; all writes go exclusively
    // through the Doctor-only setStudentFinancialAccount callable
    // (Admin SDK), never direct clients.
    match /student_financial_accounts/{studentId} {
      allow get, list: if canViewPayments() || canManagePayments() || isDoctor();
      allow write: if false;
    }

    // Manual per-Student x Subject pricing reference
    // (student_subject_pricing_database_change_authority.md): staff
    // read-only visibility for the Dashboard Payments Subjects table,
    // reusing the existing Payments read authorization
    // (canViewPayments / canManagePayments); all writes go exclusively
    // through the Doctor-only setStudentSubjectPricing callable
    // (Admin SDK), never direct clients. No subject-level payment
    // authorization is introduced here.
    match /student_subject_pricing/{pricingId} {
      allow get, list: if canViewPayments() || canManagePayments() || isDoctor();
      allow write: if false;
    }

    // Academic periods are readable by every signed-in user (students need
    // period state for their subscription boundaries). All writes happen
    // exclusively through Doctor-only Cloud Functions.
    match /academic_periods/{periodId} {
      allow get, list: if signedIn();
      allow write: if false;
    }

    // Platform-wide feature toggles are readable by staff; students read
    // only enabled features. All writes go through Doctor-only Functions.
    match /platform_features/{featureId} {
      allow get, list: if isStaff()
        || (isStudent() && resource.data.enabled == true);
      allow write: if false;
    }

    match /system_settings/{settingId} {
      allow get: if isDoctor() || canManageSettings();
      allow list: if isDoctor();
      allow write: if false;
    }

    match /video_watch_windows/{windowId} {
      // Server-only: reads go exclusively through the getVideoWatchWindow
      // callable (Admin SDK). No client — owner included — may read or
      // write these documents directly.
      allow read, write: if false;
    }

    match /password_reset_requests/{requestId} {
      allow get, list: if isDoctor() || canManageStudents() || canResetPassword();
      // Student self-request (08 §9.2) or staff with reset authority.
      // Canonical create schema: student_id, phone_number, status,
      // requested_at, created_at (server callable writes both timestamps).
      allow create: if (isDoctor() || canResetPassword() || (isStudent() && request.resource.data.student_id == request.auth.uid))
        && request.resource.data.status == 'pending'
        && request.resource.data.student_id is string
        && request.resource.data.diff({}).affectedKeys().hasOnly(['student_id', 'phone_number', 'status', 'requested_at', 'created_at'])
        && (!('phone_number' in request.resource.data) || request.resource.data.phone_number is string);
      allow update, delete: if false;
    }

    // Any collection not explicitly covered above is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
