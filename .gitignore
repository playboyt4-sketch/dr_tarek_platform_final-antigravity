# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets & signing credentials (defense in depth; also ignored in android/)
*.jks
*.keystore
key.properties

# Environment files & Firebase service accounts — never commit
.env
.env.*
*.env
serviceAccountKey*.json
*-firebase-adminsdk-*.json
firebase-adminsdk*.json
*service-account*.json
.aider*

# opencode local config (contains Figma token)
opencode.json
